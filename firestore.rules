rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function memberPath(roomId, uid) {
      return /databases/$(database)/documents/rooms/$(roomId)/members/$(uid);
    }

    function isMember(roomId) {
      return signedIn() && exists(memberPath(roomId, request.auth.uid));
    }

    function isOwner(roomId) {
      return isMember(roomId)
        && get(memberPath(roomId, request.auth.uid)).data.role == "owner";
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["name", "email", "phone", "upiId", "roomId"])
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.phone is string
        && request.resource.data.upiId is string
        && (request.resource.data.roomId is string || request.resource.data.roomId == null);
      allow delete: if false;
    }

    match /roomInvites/{token} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(["roomId", "ownerUid"])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.roomId is string
        && getAfter(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)).data.ownerUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)).data.inviteToken == token;
      allow update, delete: if false;
    }

    match /rooms/{roomId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(["code", "name", "budgetCap", "ownerUid", "roommateUid", "inviteToken", "createdAt"])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.roommateUid == null
        && request.resource.data.inviteToken is string
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.budgetCap is number
        && request.resource.data.budgetCap >= 0;
      allow get: if isMember(roomId);
      allow list, delete: if false;
      allow update: if (
        isOwner(roomId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name", "budgetCap"])
        && request.resource.data.name is string
        && request.resource.data.budgetCap is number
        && request.resource.data.budgetCap >= 0
      ) || (
        signedIn()
        && resource.data.roommateUid == null
        && request.resource.data.roommateUid == request.auth.uid
        && request.resource.data.joinedWithInviteToken is string
        && request.resource.data.joinedWithInviteToken == resource.data.inviteToken
        && exists(/databases/$(database)/documents/roomInvites/$(request.resource.data.joinedWithInviteToken))
        && get(/databases/$(database)/documents/roomInvites/$(request.resource.data.joinedWithInviteToken)).data.roomId == roomId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["roommateUid", "joinedWithInviteToken"])
      );

      match /members/{uid} {
        allow get, list: if isMember(roomId);
        allow create: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(["uid", "name", "phone", "upiId", "role", "inviteToken"])
          && request.resource.data.uid == uid
          && request.resource.data.name is string
          && request.resource.data.phone is string
          && request.resource.data.upiId is string
          && (
            (
              getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.ownerUid == request.auth.uid
              && request.resource.data.role == "owner"
            ) || (
              getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.roommateUid == request.auth.uid
              && request.resource.data.role == "roommate"
              && request.resource.data.inviteToken == getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.joinedWithInviteToken
            )
          );
        allow update: if signedIn()
          && request.auth.uid == uid
          && isMember(roomId)
          && request.resource.data.keys().hasOnly(["uid", "name", "phone", "upiId", "role", "inviteToken"])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name", "phone", "upiId"])
          && request.resource.data.name is string
          && request.resource.data.phone is string
          && request.resource.data.upiId is string;
        allow delete: if false;
      }

      match /expenses/{expenseId} {
        allow read: if isMember(roomId);
        allow create: if isMember(roomId)
          && request.resource.data.keys().hasOnly(["title", "amount", "date", "category", "split", "note", "paidByUid", "createdByUid", "updatedAt"])
          && request.resource.data.createdByUid == request.auth.uid
          && request.resource.data.paidByUid == request.auth.uid
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.category in ["rent", "electricity", "water", "vegetables", "groceries", "internet", "gas", "other"]
          && request.resource.data.split in ["50-50", "100-other", "personal"]
          && request.resource.data.date is string;
        allow update: if isMember(roomId)
          && resource.data.createdByUid == request.auth.uid
          && request.resource.data.keys().hasOnly(["title", "amount", "date", "category", "split", "note", "paidByUid", "createdByUid", "updatedAt"])
          && request.resource.data.createdByUid == resource.data.createdByUid
          && request.resource.data.paidByUid == resource.data.paidByUid
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.category in ["rent", "electricity", "water", "vegetables", "groceries", "internet", "gas", "other"]
          && request.resource.data.split in ["50-50", "100-other", "personal"]
          && request.resource.data.date is string;
        allow delete: if isMember(roomId)
          && resource.data.createdByUid == request.auth.uid;
      }

      match /settlements/{settlementId} {
        allow read: if isMember(roomId);
        allow create: if isMember(roomId)
          && request.resource.data.keys().hasOnly(["amount", "date", "note", "fromUid", "createdByUid"])
          && request.resource.data.createdByUid == request.auth.uid
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.date is string;
        allow update: if isMember(roomId)
          && resource.data.createdByUid == request.auth.uid
          && request.resource.data.keys().hasOnly(["amount", "date", "note", "fromUid", "createdByUid"])
          && request.resource.data.createdByUid == resource.data.createdByUid
          && request.resource.data.fromUid == resource.data.fromUid
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.date is string;
        allow delete: if isMember(roomId)
          && resource.data.createdByUid == request.auth.uid;
      }
    }
  }
}
