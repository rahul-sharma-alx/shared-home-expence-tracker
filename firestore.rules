rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Assumed schema:
    // users/{uid}: private name, contact email, phone, UPI ID, and legacy active room ID.
    // users/{uid}/rooms/{roomId}: private user's room selector index with room name and role.
    // rooms/{roomId}: two-person room, budget, owner, invite token, and creation time.
    // rooms/{roomId}/members/{uid}: member's denormalized display/contact details and role.
    // rooms/{roomId}/expenses/{expenseId}: creator-owned expense and payer identity.
    // rooms/{roomId}/settlements/{settlementId}: payer-created payment record.
    // roomInvites/{token}: room ID and owner UID; room name is optional for legacy invites.
    // All dates in expense/payment records are YYYY-MM-DD strings. Room-created timestamps
    // accept legacy millisecond numbers on existing rooms and server timestamps on new rooms.

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated()
        && "uid" in resource.data
        && request.auth.uid == resource.data.uid;
    }

    function uidUnchanged(data) {
      return !("uid" in data) || data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !("uid" in request.resource.data)
        || request.resource.data.uid == resource.data.uid;
    }

    function hasRequiredFields(data, fields) {
      return data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(data, fields) {
      return data.keys().hasOnly(fields);
    }

    function validString(data, field, minLength, maxLength) {
      return data[field] is string
        && data[field].size() >= minLength
        && data[field].size() <= maxLength;
    }

    function validOptionalString(data, field, maxLength) {
      return !(field in data)
        || (data[field] is string && data[field].size() <= maxLength);
    }

    function optionalFieldUnchanged(before, after, field) {
      return (
        !(field in before) && !(field in after)
      ) || (
        field in before && field in after && before[field] == after[field]
      );
    }

    function validDateString(value) {
      return value is string && value.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$");
    }

    function isRecentTimestamp(value) {
      return value is timestamp
        && value > request.time - duration.value(5, "m")
        && value <= request.time;
    }

    function isValidProfile(data) {
      return hasRequiredFields(data, ["name", "email", "phone", "upiId", "roomId"])
        && hasOnlyAllowedFields(data, ["name", "email", "phone", "upiId", "roomId"])
        && validString(data, "name", 1, 80)
        && validString(data, "email", 0, 254)
        && validString(data, "phone", 0, 20)
        && validString(data, "upiId", 0, 100)
        && (data.roomId == null || (data.roomId is string && data.roomId.size() <= 128));
    }

    function roomPath(roomId) {
      return /databases/$(database)/documents/rooms/$(roomId);
    }

    function memberPath(roomId, uid) {
      return /databases/$(database)/documents/rooms/$(roomId)/members/$(uid);
    }

    function invitePath(token) {
      return /databases/$(database)/documents/roomInvites/$(token);
    }

    function isRoomMember(roomId) {
      return isAuthenticated()
        && exists(memberPath(roomId, request.auth.uid));
    }

    function isRoomOwner(roomId) {
      return isRoomMember(roomId)
        && get(memberPath(roomId, request.auth.uid)).data.role == "owner";
    }

    function isValidRoom(data) {
      return hasRequiredFields(data, [
          "code", "name", "budgetCap", "ownerUid", "roommateUid", "inviteToken", "createdAt"
        ])
        && hasOnlyAllowedFields(data, [
          "code", "name", "budgetCap", "ownerUid", "roommateUid", "inviteToken",
          "createdAt", "joinedWithInviteToken"
        ])
        && validString(data, "code", 6, 6)
        && data.code.matches("^[A-Z0-9]{6}$")
        && validString(data, "name", 1, 80)
        && data.budgetCap is number
        && data.budgetCap >= 0
        && data.budgetCap <= 1000000000
        && validString(data, "ownerUid", 1, 128)
        && (
          data.roommateUid == null
          || (data.roommateUid is string && data.roommateUid.size() > 0 && data.roommateUid.size() <= 128)
        )
        && validString(data, "inviteToken", 48, 48)
        && data.inviteToken.matches("^[a-f0-9]{48}$")
        && (
          data.createdAt is timestamp
          || (data.createdAt is number && data.createdAt > 0 && data.createdAt < 4102444800000)
        )
        && validOptionalString(data, "joinedWithInviteToken", 48);
    }

    function isValidRoomMembership(data, roomId) {
      return hasRequiredFields(data, ["roomId", "roomName", "role"])
        && hasOnlyAllowedFields(data, ["roomId", "roomName", "role"])
        && data.roomId == roomId
        && validString(data, "roomName", 1, 80)
        && data.role in ["owner", "roommate"];
    }

    function isValidRoomMember(data) {
      return hasRequiredFields(data, ["uid", "name", "phone", "upiId", "role"])
        && hasOnlyAllowedFields(data, ["uid", "name", "phone", "upiId", "role", "inviteToken"])
        && validString(data, "uid", 1, 128)
        && validString(data, "name", 1, 80)
        && validString(data, "phone", 0, 20)
        && validString(data, "upiId", 0, 100)
        && data.role in ["owner", "roommate"]
        && validOptionalString(data, "inviteToken", 48);
    }

    function isValidRoomInvite(data) {
      return hasRequiredFields(data, ["roomId", "ownerUid"])
        && hasOnlyAllowedFields(data, ["roomId", "ownerUid", "roomName"])
        && validString(data, "roomId", 1, 128)
        && validString(data, "ownerUid", 1, 128)
        && validOptionalString(data, "roomName", 80)
        && (!("roomName" in data) || data.roomName.size() > 0);
    }

    function isValidExpense(data) {
      return hasRequiredFields(data, [
          "title", "amount", "date", "category", "split", "note",
          "paidByUid", "createdByUid", "updatedAt"
        ])
        && hasOnlyAllowedFields(data, [
          "title", "amount", "date", "category", "split", "note",
          "paidByUid", "createdByUid", "updatedAt"
        ])
        && validString(data, "title", 1, 120)
        && data.amount is number
        && data.amount > 0
        && data.amount <= 1000000000
        && validDateString(data.date)
        && data.category in ["rent", "electricity", "water", "vegetables", "groceries", "internet", "gas", "other"]
        && data.split in ["50-50", "100-other", "personal"]
        && validString(data, "note", 0, 500)
        && validString(data, "paidByUid", 1, 128)
        && validString(data, "createdByUid", 1, 128)
        && data.updatedAt is timestamp;
    }

    function isValidSettlement(data) {
      return hasRequiredFields(data, ["amount", "date", "note", "fromUid", "createdByUid"])
        && hasOnlyAllowedFields(data, ["amount", "date", "note", "fromUid", "createdByUid"])
        && data.amount is number
        && data.amount > 0
        && data.amount <= 1000000000
        && validDateString(data.date)
        && validString(data, "note", 0, 500)
        && validString(data, "fromUid", 1, 128)
        && validString(data, "createdByUid", 1, 128);
    }

    match /users/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;
      allow create, update: if isOwner(uid) && isValidProfile(request.resource.data);
      allow delete: if false;

      match /rooms/{roomId} {
        allow get, list: if isOwner(uid);
        allow create: if (isOwner(uid) || isRoomOwner(roomId))
          && isValidRoomMembership(request.resource.data, roomId)
          && existsAfter(roomPath(roomId))
          && existsAfter(memberPath(roomId, uid))
          && getAfter(memberPath(roomId, uid)).data.uid == uid
          && getAfter(memberPath(roomId, uid)).data.role == request.resource.data.role
          && (
            (isOwner(uid) && request.resource.data.role == "roommate")
            || getAfter(roomPath(roomId)).data.name == request.resource.data.roomName
          );
        allow update: if isAuthenticated()
          && isValidRoomMembership(request.resource.data, roomId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["roomName"])
          && isRoomOwner(roomId)
          && existsAfter(memberPath(roomId, uid))
          && getAfter(memberPath(roomId, uid)).data.role == resource.data.role
          && request.auth.uid == getAfter(roomPath(roomId)).data.ownerUid
          && getAfter(roomPath(roomId)).data.name == request.resource.data.roomName;
        allow delete: if false;
      }
    }

    match /roomInvites/{token} {
      allow get: if isAuthenticated();
      allow list: if false;
      allow create: if isAuthenticated()
        && isValidRoomInvite(request.resource.data)
        && request.resource.data.ownerUid == request.auth.uid
        && existsAfter(roomPath(request.resource.data.roomId))
        && getAfter(roomPath(request.resource.data.roomId)).data.ownerUid == request.auth.uid
        && getAfter(roomPath(request.resource.data.roomId)).data.inviteToken == token
        && (
          !("roomName" in request.resource.data)
          || getAfter(roomPath(request.resource.data.roomId)).data.name == request.resource.data.roomName
        );
      allow update: if isAuthenticated()
        && isValidRoomInvite(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["roomName"])
        && request.resource.data.roomId == resource.data.roomId
        && request.resource.data.ownerUid == resource.data.ownerUid
        && isRoomOwner(resource.data.roomId)
        && request.auth.uid == getAfter(roomPath(resource.data.roomId)).data.ownerUid
        && getAfter(roomPath(resource.data.roomId)).data.name == request.resource.data.roomName;
      allow delete: if false;
    }

    match /rooms/{roomId} {
      allow create: if isAuthenticated()
        && isValidRoom(request.resource.data)
        && isRecentTimestamp(request.resource.data.createdAt)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.roommateUid == null
        && !("joinedWithInviteToken" in request.resource.data);
      allow get: if isRoomMember(roomId);
      allow list, delete: if false;
      allow update: if isValidRoom(request.resource.data)
        && (
          (
            isRoomOwner(roomId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name", "budgetCap"])
            && request.resource.data.ownerUid == resource.data.ownerUid
            && request.resource.data.roommateUid == resource.data.roommateUid
            && request.resource.data.inviteToken == resource.data.inviteToken
            && request.resource.data.createdAt == resource.data.createdAt
            && optionalFieldUnchanged(
              resource.data,
              request.resource.data,
              "joinedWithInviteToken"
            )
            && request.resource.data.name.size() > 0
            && request.resource.data.budgetCap >= 0
          )
          || (
            isAuthenticated()
            && resource.data.roommateUid == null
            && request.resource.data.roommateUid == request.auth.uid
            && request.auth.uid != resource.data.ownerUid
            && request.resource.data.joinedWithInviteToken is string
            && request.resource.data.joinedWithInviteToken == resource.data.inviteToken
            && exists(invitePath(request.resource.data.joinedWithInviteToken))
            && get(invitePath(request.resource.data.joinedWithInviteToken)).data.roomId == roomId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["roommateUid", "joinedWithInviteToken"])
            && request.resource.data.ownerUid == resource.data.ownerUid
            && request.resource.data.inviteToken == resource.data.inviteToken
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.name == resource.data.name
            && request.resource.data.budgetCap == resource.data.budgetCap
          )
        );

      match /members/{memberUid} {
        allow get, list: if isRoomMember(roomId);
        allow create: if isAuthenticated()
          && request.auth.uid == memberUid
          && isValidRoomMember(request.resource.data)
          && uidUnchanged(request.resource.data)
          && request.resource.data.uid == memberUid
          && (
            (
              getAfter(roomPath(roomId)).data.ownerUid == request.auth.uid
              && request.resource.data.role == "owner"
              && !("inviteToken" in request.resource.data)
            )
            || (
              getAfter(roomPath(roomId)).data.roommateUid == request.auth.uid
              && request.resource.data.role == "roommate"
              && request.resource.data.inviteToken == getAfter(roomPath(roomId)).data.joinedWithInviteToken
            )
          );
        allow update: if isAuthenticated()
          && request.auth.uid == memberUid
          && isDocOwner()
          && isValidRoomMember(request.resource.data)
          && uidNotModified()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name", "phone", "upiId"])
          && request.resource.data.role == resource.data.role
          && optionalFieldUnchanged(resource.data, request.resource.data, "inviteToken");
        allow delete: if false;
      }

      match /expenses/{expenseId} {
        allow get, list: if isRoomMember(roomId);
        allow create: if isRoomMember(roomId)
          && isValidExpense(request.resource.data)
          && isRecentTimestamp(request.resource.data.updatedAt)
          && request.resource.data.createdByUid == request.auth.uid
          && request.resource.data.paidByUid == request.auth.uid;
        allow update: if isRoomMember(roomId)
          && isValidExpense(request.resource.data)
          && isRecentTimestamp(request.resource.data.updatedAt)
          && resource.data.createdByUid == request.auth.uid
          && request.resource.data.createdByUid == resource.data.createdByUid
          && request.resource.data.paidByUid == resource.data.paidByUid;
        allow delete: if isRoomMember(roomId)
          && resource.data.createdByUid == request.auth.uid;
      }

      match /settlements/{settlementId} {
        allow get, list: if isRoomMember(roomId);
        allow create: if isRoomMember(roomId)
          && isValidSettlement(request.resource.data)
          && request.resource.data.createdByUid == request.auth.uid
          && request.resource.data.fromUid == request.auth.uid;
        allow update: if isRoomMember(roomId)
          && isValidSettlement(request.resource.data)
          && resource.data.createdByUid == request.auth.uid
          && request.resource.data.createdByUid == resource.data.createdByUid
          && request.resource.data.fromUid == resource.data.fromUid;
        allow delete: if isRoomMember(roomId)
          && resource.data.createdByUid == request.auth.uid;
      }
    }
  }
}
